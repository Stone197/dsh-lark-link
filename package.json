{
  "name": "dsh-lark-link",
  "version": "0.7.0",
  "description": "Unified Feishu/Lark + WeChat bridge for DeepSeek Harness — QR one-click auth, live streaming run cards (reasoning/tool panels, collapsible, stop button, summary), card-based commands, queued/batched messages, zero-loss outbox, media in/out, shared settings console",
  "type": "module",
  "license": "MIT",
  "icon": "./assets/icon.svg",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amlyczz/dsh-lark-link.git"
  },
  "keywords": [
    "dsh-plugin",
    "dsh",
    "deepseek-harness",
    "feishu",
    "lark",
    "wechat",
    "weixin",
    "im",
    "bridge",
    "bot"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": "./dist/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./icon": "./assets/icon.svg",
    "./icon.svg": "./icon.svg"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.73.0",
    "axios": "^1.19.0",
    "fflate": "^0.8.3",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-agent": "*",
    "@deepseek-ai/dsh-commands": "*",
    "@deepseek-ai/dsh-credentials": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-session": "*",
    "@deepseek-ai/dsh-storage-domain": "*",
    "@deepseek-ai/dsh-system-prompt": "*",
    "@deepseek-ai/dsh-tools": "*",
    "react": "^18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent": {
      "optional": true
    },
    "@deepseek-ai/dsh-session": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/dsh-commands": {
      "optional": true
    },
    "@deepseek-ai/dsh-credentials": {
      "optional": true
    },
    "@deepseek-ai/dsh-storage-domain": {
      "optional": true
    },
    "@deepseek-ai/dsh-system-prompt": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.2",
    "@deepseek-ai/dsh-commands": "0.2.1-rc.2",
    "@deepseek-ai/dsh-credentials": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "0.2.1-rc.2",
    "@deepseek-ai/dsh-storage-domain": "0.2.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@types/node": "^24.3.0",
    "@types/qrcode": "^1.5.5",
    "@types/qrcode-terminal": "^0.12.2",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.2",
    "vitest": "^4.1.8"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "slots"
      ],
      "platform": "web"
    }
  },
  "files": [
    "dist",
    "assets",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "docs",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "dev:link": "node scripts/dev-link.mjs",
    "build": "tsdown",
    "check": "tsc --noEmit",
    "test": "node --experimental-strip-types --test \"test/**/*.test.ts\"",
    "test:wechat": "vitest run --config vitest.wechat.config.mjs",
    "test:all": "npm run test && npm run test:wechat",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=24.0.0",
    "dsh": ">=0.2.1-0 <0.3.0-0"
  }
}
